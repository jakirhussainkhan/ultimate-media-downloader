# Ultimate Media Downloader — environment template
# Copy to `.env` for local development. Never commit `.env`.
# Production deployments should inject these as real environment variables.

# Network binding. Keep 127.0.0.1 unless you intentionally want LAN exposure.
HOST=127.0.0.1
PORT=5000

# Never enable debug mode on a public server.
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Enable only when a trusted reverse proxy sets X-Forwarded-* headers.
TRUST_PROXY=false

# Maximum bytes streamed by the download proxy (default: 2 GiB).
MAX_DOWNLOAD_BYTES=2147483648

# Maximum input/output size for MP3 extraction (default: 512 MiB).
MAX_AUDIO_INPUT_BYTES=536870912

# Sliding-window rate limits (per client IP).
FETCH_RATE_LIMIT=20
DOWNLOAD_RATE_LIMIT=30
AUDIO_RATE_LIMIT=5
